<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route clean navigation URLs
  RewriteRule ^projects/?$ projects.html [L]
  RewriteRule ^dashboard/?$ dashboard.html [L]

  # Route clean project URLs like /becht or /asiancooks to project-detail.html
  RewriteRule ^([a-zA-Z0-9_-]+)/?$ project-detail.html?id=$1 [L,QSA]
</IfModule>
